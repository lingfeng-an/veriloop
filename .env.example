# VeriLoop environment configuration
# ---------------------------------------------------------------------------
# Default: fully offline mock mode. No real API is called and no API key is
# required. This is the default and intended development/demo configuration.

# When true, all LLM calls are served by the deterministic MockLLMClient.
# The pipeline never contacts a real model provider in this mode.
MOCK_LLM=true

# ---------------------------------------------------------------------------
# Real-model mode is NOT wired up. If a real provider were ever added, the
# key would live here — but no real API integration exists in the MVP.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
